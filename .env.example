# Copy of the settings both docker compose and Python read.
# "python -m slotrush up" copies this file to .env if .env does not exist yet.
# .env is git-ignored; change the passwords there if you want.

# PostgreSQL
POSTGRES_USER=slotrush
POSTGRES_PASSWORD=slotrush_dev_pw
POSTGRES_DB=slotrush
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# MongoDB
MONGO_USER=slotrush
MONGO_PASSWORD=slotrush_dev_pw
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
